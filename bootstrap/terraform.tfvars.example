# À copier en terraform.tfvars (ce fichier-là est ignoré par git).
github_owner = "ChristopheBard"
github_repo  = "secure-cloud-platform"
# Région autorisée par le lab CloudLabs (à vérifier dans la console au démarrage du lab).
region = "us-east-1"
# Format "immuable" du jeton GitHub (lu avec : gh api repos/ChristopheBard/secure-cloud-platform/actions/oidc/customization/sub)
oidc_sub_prefix = "repo:ChristopheBard@47388468/secure-cloud-platform@1427042487"
