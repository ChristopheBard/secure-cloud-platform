        <mxCell id="wiz-iam-roles" value="&lt;b&gt;IAM roles assumed via OIDC&lt;/b&gt; (STS, ~1 h, zero static keys)&lt;br&gt;• &lt;b&gt;gha-infra-plan&lt;/b&gt;: read-only, on Pull Requests&lt;br&gt;• &lt;b&gt;gha-infra-apply&lt;/b&gt;: &lt;i&gt;production&lt;/i&gt; env. + approval&lt;br&gt;• &lt;b&gt;gha-app-deploy&lt;/b&gt;: ECR push + ECS update, main branch" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;strokeColor=#DD344C;fillColor=#FFF5F5;fontColor=#232F3E;" parent="1" vertex="1">
          <mxGeometry x="130" y="850" width="330" height="85" as="geometry" />
